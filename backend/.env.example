# Copy to backend/.env and adjust. Everything here can also be changed from the
# dashboard Settings page (saved to backend/runtime_settings.json, which wins over .env).

# ---- Video source: scenario (demo clips) | ip | webcam
CAMERA_SOURCE=scenario
CAMERA_URL=http://192.168.1.100:8080/video
WEBCAM_INDEX=0
CAMERA_HFOV_DEG=70

# ---- YOLOv8 (weights must be inside backend/models/)
YOLO_MODEL_PATH=models/best.pt
YOLO_IMGSZ=640
CONFIDENCE_THRESHOLD=0.5
FIRE_CLASSES=fire,flame
SMOKE_CLASSES=smoke
# 0 = use half the CPU cores
YOLO_THREADS=0

# ---- Temporal validation: K positive frames out of the last N
TEMPORAL_WINDOW=15
TEMPORAL_MIN_POSITIVE=10

# ---- Sensors: true = simulated MQ-2 + TF-Luna, false = read the Arduino
DEMO_MODE=true
ARDUINO_PORT=COM3
BAUD_RATE=9600
SMOKE_THRESHOLD_PPM=300

# ---- Hydraulics (see README "Pressure estimation")
NOZZLE_HEIGHT_M=2.5
NOZZLE_ANGLE_DEG=30
NOZZLE_DIAMETER_MM=8
PIPE_LENGTH_M=6
PIPE_DIAMETER_MM=20
MIN_PRESSURE=0.5
MAX_PRESSURE=8.0

# ---- Presentation pacing: minimum seconds each stage stays on screen
STAGE_MIN_DWELL_S=1.5

DB_PATH=fireguard.db
